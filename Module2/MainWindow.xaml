<Window
    x:Class="BootProject.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Чудо Обувь — Каталог товаров"
    Width="900"
    Height="650"
    MinWidth="800"
    MinHeight="600"
    Background="{StaticResource main}"
    Icon="/image/icon.ico"
    WindowStartupLocation="CenterScreen">

    <DockPanel>
        <Border
            Padding="16,10"
            Background="{StaticResource dop}"
            DockPanel.Dock="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image
                    Grid.Column="0"
                    Width="56"
                    Height="56"
                    VerticalAlignment="Center"
                    Source="/Image/icon.png"
                    Stretch="Uniform" />

                <TextBlock
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="#333333"
                    Text="Чудо Обувь" />

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button Content="Каталог" Style="{StaticResource navbarButton}" />
                    <Button Content="Заказы" Style="{StaticResource navbarButton}" />
                    <Button Content="Войти" Style="{StaticResource navbarButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer
            Padding="10"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="CatalogPanel" />
        </ScrollViewer>
    </DockPanel>
</Window>