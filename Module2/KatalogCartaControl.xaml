<UserControl
    x:Class="BootProject.KatalogCartaControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="180"
    HorizontalAlignment="Stretch">

    <Border
        x:Name="CardBorder"
        Margin="5"
        Padding="10"
        Background="{StaticResource main}"
        BorderBrush="{StaticResource akcent}"
        BorderThickness="1">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="0,0,10,0"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
                <Image
                    Margin="5"
                    Source="{Binding ImagePath}"
                    Stretch="Uniform" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="18"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap">
                    <Run Text="{Binding Manufacturer}" />
                    <Run Text=" | " />
                    <Run Text="{Binding Name}" />
                </TextBlock>

                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="14"
                    Foreground="Black">
                    <Run Text="Категория: " />
                    <Run Text="{Binding Category}" />
                </TextBlock>

                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="14"
                    Foreground="Black">
                    <Run Text="В наличии: " />
                    <Run FontWeight="Bold" Text="{Binding QuantityIndicator}" />
                    <Run Text=" (" />
                    <Run Text="{Binding TotalQuantity}" />
                    <Run Text=" шт.)" />
                </TextBlock>
            </StackPanel>

            <TextBlock
                Grid.Column="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="24"
                FontWeight="Bold"
                Foreground="{StaticResource akcent}"
                Text="{Binding Price, StringFormat='{}{0:N0} ₽'}" />
        </Grid>
    </Border>
</UserControl>