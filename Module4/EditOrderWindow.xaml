<Window
    x:Class="BootProject.EditOrderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Редактирование заказа"
    MinWidth="400"
    MinHeight="270"
    MaxWidth="500"
    MaxHeight="300"
    Background="{StaticResource main}"
    WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock
            Margin="0,0,0,5"
            FontWeight="SemiBold"
            Text="Дата заказа:" />
        <DatePicker
            x:Name="OrderDatePicker"
            Height="30"
            Margin="0,0,0,15"
            SelectedDateFormat="Short" />

        <TextBlock
            Margin="0,0,0,5"
            FontWeight="SemiBold"
            Text="Количество (0 для удаления):" />
        <TextBox
            x:Name="QtyTextBox"
            Height="30"
            Margin="0,0,0,5"
            Padding="5,0"
            VerticalContentAlignment="Center" />

        <TextBlock
            x:Name="StockHintText"
            Margin="0,0,0,20"
            FontSize="12"
            Foreground="Gray" />

        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
                Width="120"
                Margin="0,0,10,0"
                Click="SaveButton_Click"
                Content="Сохранить"
                Style="{StaticResource navbarButton}" />
            <Button
                Width="120"
                Background="#555555"
                Click="CancelButton_Click"
                Content="Отмена"
                Style="{StaticResource navbarButton}" />
        </StackPanel>
    </StackPanel>
</Window>