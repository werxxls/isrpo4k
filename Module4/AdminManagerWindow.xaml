<Window
    x:Class="BootProject.AdminManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Панель управления"
    MinWidth="600"
    MinHeight="400"
    MaxWidth="750"
    MaxHeight="550"
    Background="{StaticResource main}"
    WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,30"
            HorizontalAlignment="Center"
            FontSize="24"
            FontWeight="Bold"
            Foreground="Black"
            Text="Панель управления" />
        <TextBlock
            x:Name="RoleText"
            Grid.Row="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            FontSize="14"
            Foreground="Gray" />

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Width="200"
                Height="60"
                Margin="0,0,20,0"
                Click="ProductsButton_Click"
                Content="Товары (Каталог)"
                FontSize="18"
                Style="{StaticResource navbarButton}" />
            <Button
                Width="200"
                Height="60"
                Click="OrdersButton_Click"
                Content="Заказы"
                FontSize="18"
                Style="{StaticResource navbarButton}" />
        </StackPanel>

        <Button
            Grid.Row="2"
            Width="150"
            HorizontalAlignment="Center"
            Background="#555555"
            Click="LogoutButton_Click"
            Content="Выйти"
            Style="{StaticResource navbarButton}" />
    </Grid>
</Window>