<Window
    x:Class="BootProject.AuthUserWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Чудо Обувь - Личный кабинет"
    MinWidth="900"
    MinHeight="700"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <DockPanel>
            <Border
                Padding="16,10"
                Background="{StaticResource dop}"
                DockPanel.Dock="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        Width="56"
                        Height="56"
                        VerticalAlignment="Center"
                        Source="/Image/icon.png"
                        Stretch="Uniform" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="#333333"
                        Text="Чудо Обувь" />

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            x:Name="UserFullNameText"
                            Margin="0,0,15,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#333333" />
                        <!--  НОВАЯ КНОПКА КОРЗИНЫ  -->
                        <Button
                            Margin="0,0,10,0"
                            Background="#70B2AF"
                            Click="CartButton_Click"
                            Content="Моя корзина"
                            Style="{StaticResource navbarButton}" />
                        <Button
                            x:Name="LogoutButton"
                            Click="LogoutButton_Click"
                            Content="Выйти"
                            Style="{StaticResource navbarButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Padding="10"
                Background="#F0F0F0"
                DockPanel.Dock="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="SearchTextBox"
                        Grid.Column="0"
                        Height="30"
                        Padding="5,0"
                        VerticalContentAlignment="Center"
                        TextChanged="SearchTextBox_TextChanged"
                        ToolTip="Поиск..." />
                    <ComboBox
                        x:Name="CategoryComboBox"
                        Grid.Column="1"
                        Height="30"
                        Margin="10,0,0,0"
                        SelectionChanged="CategoryComboBox_SelectionChanged" />
                    <ComboBox
                        x:Name="SortComboBox"
                        Grid.Column="2"
                        Height="30"
                        Margin="10,0,0,0"
                        SelectionChanged="SortComboBox_SelectionChanged">
                        <ComboBoxItem Content="По умолчанию" IsSelected="True" />
                        <ComboBoxItem Content="Цена (по возрастанию)" />
                        <ComboBoxItem Content="Цена (по убыванию)" />
                    </ComboBox>
                </Grid>
            </Border>

            <ScrollViewer
                Padding="10"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="CatalogPanel" />
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>