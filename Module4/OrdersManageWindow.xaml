<Window
    x:Class="BootProject.OrdersManageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Управление заказами"
    MinWidth="950"
    MinHeight="500"
    MaxWidth="1200"
    MaxHeight="650"
    Background="{StaticResource main}"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid
            x:Name="OrdersDataGrid"
            Grid.Row="0"
            AutoGenerateColumns="False"
            Background="White"
            CanUserAddRows="False"
            IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="180"
                    Binding="{Binding UserFIO}"
                    Header="Кто заказал" />

                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding ProductName}"
                    Header="Товар" />

                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding Manufacturer}"
                    Header="Производство" />

                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding SizeValue}"
                    Header="Размер" />

                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding Quantity}"
                    Header="Кол-во" />

                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding Price, StringFormat='{}{0:N0} ₽'}"
                    Header="Цена за шт." />

                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding Total, StringFormat='{}{0:N0} ₽'}"
                    Header="Итого" />

                <DataGridTemplateColumn Width="130" Header="Действие">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                x:Name="EditBtn"
                                Padding="5,2"
                                Background="#70B2AF"
                                BorderThickness="0"
                                Click="EditOrder_Click"
                                Content="Редактировать"
                                Cursor="Hand"
                                Foreground="White" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel
            Grid.Row="1"
            Margin="0,15,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="120"
                Background="#555555"
                Click="CloseButton_Click"
                Content="Закрыть"
                Style="{StaticResource navbarButton}" />
        </StackPanel>
    </Grid>
</Window>