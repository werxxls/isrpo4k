<UserControl
    x:Class="BootProject.KatalogCartaControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="180"
    HorizontalAlignment="Stretch"
    Cursor="Hand">

    <Border
        x:Name="CardBorder"
        Margin="5"
        Padding="12"
        Background="{StaticResource main}"
        BorderBrush="{StaticResource akcent}"
        BorderThickness="1"
        CornerRadius="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="0,0,10,0"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
                <Image
                    Margin="5"
                    Source="{Binding ImagePath, Mode=OneWay}"
                    Stretch="Uniform" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="Black"
                    TextWrapping="Wrap">
                    <Run Text="{Binding Manufacturer, Mode=OneWay}" />
                    <Run Text=" | " />
                    <Run Text="{Binding Name, Mode=OneWay}" />
                </TextBlock>

                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="14"
                    Foreground="Black">
                    <Run Text="Категория: " />
                    <Run Text="{Binding Category, Mode=OneWay}" />
                </TextBlock>

                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="14"
                    Foreground="Black">
                    <Run Text="В наличии: " />
                    <Run FontWeight="Bold" Text="{Binding QuantityIndicator, Mode=OneWay}" />
                    <Run Text=" (" />
                    <Run Text="{Binding TotalQuantity, Mode=OneWay}" />
                    <Run Text=" шт.)" />
                </TextBlock>
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="16"
                    Foreground="Gray"
                    Text="{Binding Price, StringFormat='{}{0:N0} ₽', Mode=OneWay}"
                    TextDecorations="Strikethrough">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDiscounted, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="Black"
                    Text="{Binding FinalPrice, StringFormat='{}{0:N0} ₽', Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>